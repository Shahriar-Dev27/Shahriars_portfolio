# Copy to .env.local (git-ignored) for local dev. Never commit real keys.
# Primary: Groq GPT-OSS 120B
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional backup: NVIDIA GPT-OSS 20B (skipped if its key is empty)
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
# Production: comma-separated exact origins
ALLOWED_ORIGINS=
